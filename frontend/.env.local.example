# supabase.com → project → Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Backend URL (local dev)
NEXT_PUBLIC_API_URL=http://localhost:8000
