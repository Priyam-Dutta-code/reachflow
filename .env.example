# ReachFlow backend environment
# Copy to .env and fill in your production values.

APP_ENV=development
ENABLE_BACKGROUND_WORKER=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_ENCRYPTION_KEY=replace_me_with_a_long_random_secret
# Optional: allow preview deploys for your Vercel project.
# FRONTEND_PREVIEW_REGEX=^https://reachflow-indol(?:-git-[a-z0-9-]+)?\\.vercel\\.app$

# Database
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxx.supabase.co:5432/postgres

# Supabase auth verification
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_placeholder
# SUPABASE_JWT_SECRET=

# AI
GROQ_API_KEY=gsk_placeholder

# Email sending
SENDER_EMAIL=you@example.com
GMAIL_PASSWORD=xxxx xxxx xxxx xxxx

# Redis (optional when ENABLE_BACKGROUND_WORKER=false)
REDIS_URL=

# Optional integrations
# CASHFREE_APP_ID=
# CASHFREE_SECRET_KEY=
# CASHFREE_ENV=TEST
# GOOGLE_MAPS_API_KEY=
# APOLLO_API_KEY=

# Deployment URLs
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000
