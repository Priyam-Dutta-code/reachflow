# ─────────────────────────────────────────────────────────────────
# ReachFlow — Backend .env
# Copy to .env and fill in your values, then: python start.py
# ─────────────────────────────────────────────────────────────────

# ── Database (Supabase free tier) ─────────────────────────
# supabase.com → project → Settings → Database → Connection String → URI
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxx.supabase.co:5432/postgres

# ── Supabase (for JWT verification) ───────────────────────
# supabase.com → project → Settings → API Keys → Publishable key
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...

# Legacy JWT secret (optional fallback — not needed with new Supabase projects)
# SUPABASE_JWT_SECRET=

# ── AI — Groq (free) ──────────────────────────────────────
# https://console.groq.com → API Keys
GROQ_API_KEY=gsk_...

# ── Email Sending ──────────────────────────────────────────
# Gmail app password (NOT your real password):
# myaccount.google.com → Security → App Passwords → Mail
SENDER_EMAIL=you@gmail.com
GMAIL_PASSWORD=xxxx xxxx xxxx xxxx

# ── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Optional ───────────────────────────────────────────────
# CASHFREE_APP_ID=
# CASHFREE_SECRET_KEY=
# CASHFREE_ENV=TEST
# GOOGLE_MAPS_API_KEY=
# APOLLO_API_KEY=

# ── Deployment URLs ────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000
