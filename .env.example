# ReachFlow V2 environment (Appendix B of REACHFLOW_V2_MASTER_PLAN.md).
# Copy to .env. Server-side only — NEVER commit a real .env.
#
# Dev quick-start: the defaults marked [dev-ok] are enough for
# `docker compose -f compose.dev.yml up`.

# ── Core ────────────────────────────────────────────────────────────
APP_ENV=development
# Public URL of the app (prod: https://app.<domain>)
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# How the web container reaches the api over the Docker network
API_INTERNAL_URL=http://api:8000

# ── Database & cache ────────────────────────────────────────────────
# [dev-ok] compose.dev.yml derives DATABASE_URL/REDIS_URL from POSTGRES_PASSWORD
POSTGRES_PASSWORD=reachflow_dev
# Set explicitly when running the api outside compose:
# DATABASE_URL=postgresql://reachflow:reachflow_dev@localhost:5432/reachflow
# REDIS_URL=redis://localhost:6379/0

# ── Secrets (generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))") ──
# Signs access JWTs (Phase 3). Rotating it logs everyone out.
JWT_SECRET=replace_me
# Encrypts stored user secrets (Gmail app passwords, Groq keys).
# Rotating it requires re-encryption — see docs/RUNBOOK.md (Phase 11).
APP_ENCRYPTION_KEY=replace_me
# Protects /internal/cron/* tick endpoints (GitHub Actions scheduler, D-001)
CRON_SECRET=replace_me

# ── Auth/session tuning (Phase 3) ───────────────────────────────────
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# ── Outbound email for auth flows (verification/reset) — Phase 3 ────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=
MAIL_FROM=ReachFlow <you@example.com>

# ── AI drafting ─────────────────────────────────────────────────────
# Global fallback; users can bring their own key (stored encrypted).
GROQ_API_KEY=

# ── Optional lead sources ───────────────────────────────────────────
GOOGLE_MAPS_API_KEY=
APOLLO_API_KEY=
# Selenium/LinkedIn source is off by default (arm64: distro chromium only)
ENABLE_SELENIUM_SOURCES=false

# ── Background jobs ─────────────────────────────────────────────────
# true in prod (Celery worker + beat); false = in-process local-light mode
ENABLE_BACKGROUND_WORKER=true

# ── Payments (Cashfree) — Phase 4/5, disabled-safe when empty ───────
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=TEST
CASHFREE_WEBHOOK_SECRET=

# ── Edge / infra (Phase 1) ──────────────────────────────────────────
# Cloudflare Zero Trust → Tunnels → token for the cloudflared container
CLOUDFLARE_TUNNEL_TOKEN=

# ── Self-hosted analytics (Phase 9, optional; D-001: Umami Cloud free) ──
# Operator inbox for in-app feedback + ops alerts (api-side)
ALERT_EMAIL=
# Web-side (build-time, must be NEXT_PUBLIC_): paste from Umami Cloud or
# your Umami-on-Vercel instance. Leave blank to disable analytics entirely.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js

# ── Backups & alerts (Phase 11) ─────────────────────────────────────
# rclone remote for offsite copies, e.g. r2:reachflow-backups
BACKUP_REMOTE=
# BACKUP_PASSPHRASE lives only in CI/your password manager — NEVER in .env that
# could be committed. It is the only thing that can decrypt a dump.
